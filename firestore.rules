rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function has(roles) { return signedIn() && me().role in roles; }
    function isStaff() { return has(['admin', 'super_admin', 'verification_admin', 'support_admin', 'finance_admin', 'content_admin']); }
    function isSuper() { return has(['super_admin']); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function appt(id) { return get(/databases/$(database)/documents/appointments/$(id)).data; }
    function inAppt(id) { return signedIn() && (appt(id).patientId == request.auth.uid || appt(id).doctorId == request.auth.uid); }
    function profileEditable(uid) { return isOwner(uid) && request.resource.data.status == resource.data.status; }

    // ---------- users: a client can only ever create a 'patient' ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create: if isOwner(uid)
                    && request.resource.data.role == 'patient'
                    && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt', 'consentAt']);
      allow update: if isOwner(uid) && changed().hasOnly(['name', 'deactivated', 'deletionRequested', 'updatedAt']);
      allow update: if isSuper();
      // Verification admins may only promote a patient to a provider role.
      allow update: if has(['verification_admin', 'admin'])
                    && changed().hasOnly(['role'])
                    && resource.data.role == 'patient'
                    && request.resource.data.role in ['doctor', 'hospital', 'pharmacy', 'diagnostic', 'ambulance'];
      allow delete: if false;
    }

    // ---------- private patient health profile ----------
    match /patients/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;
    }

    // ---------- provider profiles: pending until an admin verifies ----------
    match /doctors/{uid} {
      allow read: if signedIn() && (resource.data.status == 'verified' || isOwner(uid) || isStaff());
      allow create: if isOwner(uid) && request.resource.data.status == 'pending';
      allow update: if isOwner(uid) && resource.data.status == 'pending' && request.resource.data.status == 'pending';
      allow update: if isOwner(uid) && resource.data.status == 'verified'
                    && changed().hasOnly(['fee', 'about', 'hospital', 'experience', 'days', 'startTime', 'endTime', 'slotMinutes', 'imageUrl', 'imagePath', 'updatedAt']);
      allow update: if has(['verification_admin', 'admin', 'super_admin']);
    }
    match /hospitals/{uid} {
      allow read: if signedIn() && (resource.data.status == 'verified' || isOwner(uid) || isStaff());
      allow create: if isOwner(uid) && request.resource.data.status == 'pending';
      allow update: if profileEditable(uid);
      allow update: if has(['verification_admin', 'admin', 'super_admin']);
    }
    match /pharmacies/{uid} {
      allow read: if signedIn() && (resource.data.status == 'verified' || isOwner(uid) || isStaff());
      allow create: if isOwner(uid) && request.resource.data.status == 'pending';
      allow update: if profileEditable(uid);
      allow update: if has(['verification_admin', 'admin', 'super_admin']);
    }
    match /diagnostic_centers/{uid} {
      allow read: if signedIn() && (resource.data.status == 'verified' || isOwner(uid) || isStaff());
      allow create: if isOwner(uid) && request.resource.data.status == 'pending';
      allow update: if profileEditable(uid);
      allow update: if has(['verification_admin', 'admin', 'super_admin']);
    }
    match /ambulance_providers/{uid} {
      allow read: if signedIn() && (resource.data.status == 'verified' || isOwner(uid) || isStaff());
      allow create: if isOwner(uid) && request.resource.data.status == 'pending';
      allow update: if profileEditable(uid);
      allow update: if has(['verification_admin', 'admin', 'super_admin']);
    }

    match /affiliation_requests/{id} {
      allow read: if signedIn() && (resource.data.doctorId == request.auth.uid || resource.data.hospitalId == request.auth.uid
                  || resource.data.status == 'approved' || isStaff());
      allow create: if signedIn() && request.resource.data.doctorId == request.auth.uid && request.resource.data.status == 'pending' && has(['doctor']);
      allow update: if signedIn() && resource.data.hospitalId == request.auth.uid && changed().hasOnly(['status', 'updatedAt']);
    }

    // ---------- appointments: the slot document is the lock ----------
    match /appointment_slots/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && !exists(/databases/$(database)/documents/appointment_slots/$(id))
                    && request.resource.data.keys().hasOnly(['doctorId', 'date', 'slot', 'appointmentId'])
                    && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.patientId == request.auth.uid;
      allow delete: if signedIn() && (resource.data.doctorId == request.auth.uid || appt(resource.data.appointmentId).patientId == request.auth.uid);
      allow update: if false;
    }
    match /appointments/{id} {
      allow read: if signedIn() && (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid || has(['admin', 'super_admin']));
      allow create: if signedIn() && request.resource.data.patientId == request.auth.uid
                    && request.resource.data.status == 'booked'
                    && request.resource.data.paymentStatus == 'unpaid'
                    && existsAfter(/databases/$(database)/documents/appointment_slots/$(request.resource.data.slotId))
                    && getAfter(/databases/$(database)/documents/appointment_slots/$(request.resource.data.slotId)).data.appointmentId == id;
      allow update: if signedIn() && resource.data.patientId == request.auth.uid && resource.data.status == 'booked'
                    && changed().hasOnly(['status']) && request.resource.data.status == 'cancelled';
      allow update: if signedIn() && resource.data.doctorId == request.auth.uid
                    && changed().hasOnly(['status', 'doctorNotes']) && request.resource.data.status in ['completed', 'cancelled'];
      allow update: if has(['finance_admin', 'admin', 'super_admin']) && changed().hasOnly(['paymentStatus']);
      allow delete: if false;

      match /messages/{mid} {
        allow read: if inAppt(id);
        allow create: if inAppt(id) && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string && request.resource.data.text.size() <= 1000
                      && request.resource.data.keys().hasOnly(['text', 'senderId', 'createdAt']);
        allow update, delete: if false;
      }
    }

    // ---------- prescriptions: immutable, only the treating doctor can issue ----------
    match /prescriptions/{id} {
      allow read: if signedIn() && (resource.data.patientId == request.auth.uid || resource.data.doctorId == request.auth.uid || has(['admin', 'super_admin']));
      allow create: if has(['doctor']) && request.resource.data.doctorId == request.auth.uid
                    && appt(request.resource.data.appointmentId).doctorId == request.auth.uid
                    && appt(request.resource.data.appointmentId).patientId == request.resource.data.patientId
                    && request.resource.data.medicines.size() <= 15;
      allow update, delete: if false;
    }

    // ---------- medical records: owner + doctors the patient shared with ----------
    match /medical_records/{id} {
      allow read: if signedIn() && (resource.data.patientId == request.auth.uid || request.auth.uid in resource.data.sharedWith);
      allow create: if signedIn() && request.resource.data.patientId == request.auth.uid && request.resource.data.sharedWith.size() <= 10;
      allow update: if signedIn() && resource.data.patientId == request.auth.uid && request.resource.data.patientId == resource.data.patientId
                    && request.resource.data.sharedWith.size() <= 10;
      allow delete: if false;
    }

    // ---------- personal tracking ----------
    match /medicine_reminders/{id} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }
    match /reminder_logs/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /health_entries/{id} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ---------- reviews ----------
    match /reviews/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.patientId == request.auth.uid
                            && id == request.resource.data.targetId + '_' + request.auth.uid
                            && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow delete: if isStaff();
    }

    // ---------- pharmacy ----------
    match /medicines/{id} {
      allow read: if signedIn();
      allow create: if has(['pharmacy']) && request.resource.data.pharmacyId == request.auth.uid;
      allow update: if has(['pharmacy']) && resource.data.pharmacyId == request.auth.uid && request.resource.data.pharmacyId == request.auth.uid;
      allow delete: if signedIn() && resource.data.pharmacyId == request.auth.uid;
    }
    match /medicine_orders/{id} {
      allow read: if signedIn() && (resource.data.patientId == request.auth.uid || resource.data.pharmacyId == request.auth.uid || has(['admin', 'super_admin']));
      allow create: if signedIn() && request.resource.data.patientId == request.auth.uid && request.resource.data.status == 'placed'
                    && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 20;
      allow update: if signedIn() && resource.data.pharmacyId == request.auth.uid && changed().hasOnly(['status', 'total', 'updatedAt']);
      allow update: if signedIn() && resource.data.patientId == request.auth.uid && resource.data.status == 'placed'
                    && changed().hasOnly(['status', 'updatedAt']) && request.resource.data.status == 'cancelled';
    }

    // ---------- diagnostics ----------
    match /lab_tests/{id} {
      allow read: if signedIn();
      allow create: if has(['diagnostic']) && request.resource.data.centerId == request.auth.uid;
      allow update: if has(['diagnostic']) && resource.data.centerId == request.auth.uid && request.resource.data.centerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.centerId == request.auth.uid;
    }
    match /test_bookings/{id} {
      allow read: if signedIn() && (resource.data.patientId == request.auth.uid || resource.data.centerId == request.auth.uid || has(['admin', 'super_admin']));
      allow create: if signedIn() && request.resource.data.patientId == request.auth.uid && request.resource.data.status == 'booked';
      allow update: if signedIn() && resource.data.centerId == request.auth.uid && changed().hasOnly(['status', 'reportSummary', 'updatedAt']);
      allow update: if signedIn() && resource.data.patientId == request.auth.uid && resource.data.status == 'booked'
                    && changed().hasOnly(['status', 'updatedAt']) && request.resource.data.status == 'cancelled';
    }

    // ---------- blood donation: phone numbers stay private ----------
    match /blood_donors/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && !('phone' in request.resource.data);
      match /private/{doc} {
        allow read: if isOwner(uid) || exists(/databases/$(database)/documents/blood_donors/$(uid)/grants/$(request.auth.uid));
        allow write: if isOwner(uid);
      }
      match /grants/{other} {
        allow read: if isOwner(uid) || isOwner(other);
        allow write: if isOwner(uid);
      }
    }
    match /blood_requests/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.requesterId == request.auth.uid && request.resource.data.status == 'open'
                    && request.resource.data.expiresAt <= request.time + duration.value(3, 'd')
                    && request.resource.data.units >= 1 && request.resource.data.units <= 10;
      allow update: if signedIn() && resource.data.requesterId == request.auth.uid && changed().hasOnly(['status', 'updatedAt']);
      match /responses/{did} {
        allow read: if signedIn() && (isOwner(did) || get(/databases/$(database)/documents/blood_requests/$(id)).data.requesterId == request.auth.uid);
        allow create: if isOwner(did) && request.resource.data.donorId == request.auth.uid;
      }
    }

    // ---------- ambulance ----------
    match /ambulance_requests/{id} {
      allow read: if signedIn() && (resource.data.patientId == request.auth.uid || resource.data.providerId == request.auth.uid || has(['admin', 'super_admin']));
      allow create: if signedIn() && request.resource.data.patientId == request.auth.uid && request.resource.data.status == 'requested';
      allow update: if signedIn() && resource.data.providerId == request.auth.uid && changed().hasOnly(['status', 'updatedAt']);
    }

    // ---------- payments: client can only submit, never confirm ----------
    match /payments/{id} {
      allow read: if signedIn() && (resource.data.patientId == request.auth.uid || has(['finance_admin', 'admin', 'super_admin']));
      allow create: if signedIn() && request.resource.data.patientId == request.auth.uid && request.resource.data.status == 'submitted';
      allow update: if has(['finance_admin', 'admin', 'super_admin']);
    }

    // ---------- content & support ----------
    match /health_articles/{id} {
      allow read: if signedIn() && (resource.data.status == 'published' || resource.data.authorId == request.auth.uid || isStaff());
      allow create: if has(['doctor']) && request.resource.data.authorId == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.featured == false;
      allow update, delete: if has(['content_admin', 'admin', 'super_admin']);
    }
    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if has(['content_admin', 'admin', 'super_admin']);
    }
    match /support_tickets/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || has(['support_admin', 'admin', 'super_admin']));
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'open';
      allow update: if has(['support_admin', 'admin', 'super_admin']);
    }

    // ---------- audit logs: append-only ----------
    match /audit_logs/{id} {
      allow read: if isSuper();
      allow create: if isStaff() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }
    match /app_settings/{id} {
      allow read: if signedIn();
      allow write: if isSuper();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
